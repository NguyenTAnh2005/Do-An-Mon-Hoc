### ============ WEB — BACKEND (FastAPI / Python) ============
WEB/BACKEND/__pycache__/
WEB/BACKEND/**/__pycache__/
WEB/BACKEND/venv/
WEB/BACKEND/.venv/
WEB/BACKEND/*.egg-info/
WEB/BACKEND/.pytest_cache/

# Alembic — giữ lại thư mục versions, chỉ ignore cache nếu có
WEB/BACKEND/**/*.pyc

### ============ WEB — FRONTEND (React) ============
WEB/FRONTEND/node_modules/
WEB/FRONTEND/dist/
WEB/FRONTEND/build/
WEB/FRONTEND/.vite/
WEB/FRONTEND/*.local

### ============ AI_CNN — Python + model + dataset ============
AI_CNN/__pycache__/
AI_CNN/**/__pycache__/
AI_CNN/venv/
AI_CNN/.venv/

# Model weight — thường nặng, không nên push lên git
AI_CNN/*.pt
AI_CNN/*.onnx
AI_CNN/weights/

# Dataset tải từ Roboflow — nặng, mỗi người tự tải lại theo hướng dẫn trong README
AI_CNN/data/
AI_CNN/dataset/
AI_CNN/datasets/

# Kết quả train (log, ảnh output của YOLO...)
AI_CNN/runs/

# Ảnh tạm lưu frame trước khi gửi lên BACKEND
AI_CNN/model
AI_CNN/tmp_frames/
AI_CNN/*.jpg
AI_CNN/*.png
!AI_CNN/**/sample/*.jpg

