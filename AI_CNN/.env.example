# .env.example — Mẫu cấu hình cho AI_CNN
# Copy file này thành .env rồi điền giá trị thật.
# KHÔNG commit file .env lên Git.

# === EMQX Cloud Serverless (Anh cung cấp) ===
MQTT_HOST=xxxxx.emqx.io
MQTT_PORT=8883
MQTT_USER=
MQTT_PASS=

# === Backend API (Anh cung cấp) ===
BACKEND_URL=http://localhost:8000/api/upload

# === ROI size (kích thước vùng nhận diện) ===
# 280 = máy CPU yếu (dùng để test logic)
# 640 = máy có GPU NVIDIA (dùng khi demo thật)
ROI_SIZE=640